<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Pickup Manager" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if user_signed_in? %>
      <header class="header">
        <span class="header-title">粗大回収管理</span>
        <div class="header-user">
          ログイン中: <%= current_user.name %>(<%= current_user.sales? ? "営業" : "ドライバー部門" %>)
          <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "btn-logout" %>
        </div>
      </header>
    <% end %>

  <div class="container">
    <p><%= notice %></p>
    <p><%= alert %></p>
  <%= yield %>
  </div>
  </body>
</html>
