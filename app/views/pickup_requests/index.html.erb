<h2>粗大回収依頼一覧</h2>

<% if current_user.sales? %>
  <%= link_to "新規登録", new_pickup_request_path %>
<% end %>

<%= form_with url: pickup_requests_path, method: :get do |form| %>
  <%= form.text_field :keyword, value: params[:keyword], placeholder: "会社名・品目" %>

  <%= form.label :status, "ステータス" %>
  <%= form.select :status,[["確認中", "confirmed"],["確定", "scheduled"],["完了", "completed"],["キャンセル","canceled"]],
  { include_blank: "すべて", selected: params[:status]} %>

  <%= form.submit "検索" %>
<% end %>

<table>
  <tr>
    <th>会社名</th>
    <th>回収日時</th>
    <th>回収品目</th>
    <th>ステータス</th>
    <th></th>
  </tr>
  <% @pickup_requests.each do |request| %>
    <tr>
      <td><%= request.company_name %></td>
      <td><%= request.scheduled_at %></td>
      <td><%= request.items %></td>
      <td><%= request.status_i18n %></td>
      <td><%= link_to "詳細", pickup_request_path(request) %></td>
    </tr>
  <% end %>
</table>
